{
  "name": "mineradio",
  "productName": "Mineradio",
  "version": "1.1.5",
  "description": "沉浸式音乐播放器，融合天气电台、歌词舞台、粒子视觉和 3D 歌单架。",
  "author": "Mikalinsa",
  "license": "GPL-3.0-only",
  "homepage": "https://github.com/Mikalinsa/Mineradio-derivative-work#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mikalinsa/Mineradio-derivative-work.git"
  },
  "bugs": {
    "url": "https://github.com/Mikalinsa/Mineradio-derivative-work/issues"
  },
  "main": "desktop/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win nsis",
    "build:win:dir": "electron-builder --win dir",
    "pack:preview": "node scripts/pack-preview.js",
    "package:installer": "node scripts/build-installer.js",
    "notices:dependencies": "node scripts/generate-dependency-notices.js",
    "release:notes": "node scripts/prepare-github-release-notes.js",
    "release:manifest": "node scripts/prepare-publication-manifest.js"
  },
  "build": {
    "appId": "com.mineradio.desktop",
    "productName": "Mineradio",
    "copyright": "Mineradio Mikalinsa Edition - derivative work by Mikalinsa",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "afterPack": "build/after-pack.js",
    "compression": "maximum",
    "toolsets": {
      "winCodeSign": "1.1.0"
    },
    "files": [
      "desktop/**/*",
      "public/**/*",
      "obs/**/*",
      "resources/obs/**/*",
      "resources/location/**/*",
      "resources/vendor/kugoumusicapi/**/*",
      "providers/**/*",
      "licenses/**/*",
      "LICENSE",
      "NOTICE.md",
      "THIRD_PARTY_NOTICES.md",
      "PRIVACY.md",
      "SECURITY.md",
      "BUILDING.md",
      "server.js",
      "dj-analyzer.js",
      "package.json",
      "!**/.cookie",
      "!**/.qq-cookie",
      "!**/.kugou-cookie",
      "!**/.kuwo-cookie",
      "!**/.env*",
      "!**/*.log",
      "!**/updates/**/*",
      "!**/wallpaper-cache/**/*",
      "!**/backups/**/*",
      "!public/index.*.html",
      "public/index.html"
    ],
    "asar": false,
    "win": {
      "executableName": "Mineradio",
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "allowElevation": true,
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "zh_CN"
      ],
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Mineradio",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "include": "build/installer.nsh",
      "artifactName": "Mineradio-Mikalinsa-${version}-Setup.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Mikalinsa",
        "repo": "Mineradio-derivative-work"
      }
    ]
  },
  "mineradio": {
    "edition": "Mikalinsa Edition",
    "creator": "Mikalinsa",
    "update": {
      "provider": "github",
      "owner": "Mikalinsa",
      "repo": "Mineradio-derivative-work",
      "preview": true,
      "preferMirrors": true,
      "mirrors": [
        "https://gh.llkk.cc/",
        "https://ghfast.top/",
        "https://gh-proxy.com/"
      ]
    }
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "axios": "^1.1.3",
    "big-integer": "^1.6.52",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "gsap": "^3.15.0",
    "mpg123-decoder": "^1.0.3",
    "NeteaseCloudMusicApi": "^4.32.0",
    "node-forge": "^1.3.3",
    "pako": "^2.1.0",
    "qrcode": "^1.5.4",
    "safe-decode-uri-component": "^1.2.1"
  },
  "devDependencies": {
    "all-the-cities": "^3.1.0",
    "electron": "^42.11.16",
    "electron-builder": "^26.15.3",
    "rcedit": "^5.0.2"
  }
}
